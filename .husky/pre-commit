#!/bin/sh
set -e

echo "🔍 Running pre-commit checks (CLAUDE.md enforcement)..."

echo ""
echo "1️⃣  TypeScript type check..."
pnpm type-check || {
  echo "❌ Type check failed. Commit blocked."
  exit 1
}

echo ""
echo "2️⃣  ESLint validation..."
pnpm lint || {
  echo "❌ Lint check failed. Commit blocked."
  exit 1
}

echo ""
echo "3️⃣  Formatting staged files..."
pnpm lint-staged

echo ""
echo "✅ All checks passed. Proceeding with commit."
