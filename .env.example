# Where the browser reaches the NestJS API. Must include the /api prefix.
NEXT_PUBLIC_API_BASE_URL="http://localhost:5000/api"

# Base64-encoded RS256 public PEM, the same value the backend holds.
# proxy.ts verifies session cookies with it; portal routes bounce to /login
# when it is missing. The private half never leaves the backend.
JWT_PUBLIC_KEY=""

# The public origin this site is served from. Used for canonical URLs,
# Open Graph metadata, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stripe publishable key. Payments stay disabled while this is empty.
NEXT_PUBLIC_STRIPE_KEY=""
NEXT_PUBLIC_ENABLE_STRIPE="false"

# Sentry DSN. Errors report only while this is set, so an empty value keeps
# local runs out of the project. Its origin is added to the CSP connect-src
# automatically — a hardcoded host is never needed.
NEXT_PUBLIC_SENTRY_DSN=""

# Source-map upload at build time. Optional; without a token the build skips it.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Comma-separated social providers to advertise on the auth screens.
# Leave empty to show none.
NEXT_PUBLIC_AUTH_PROVIDERS=""

# Development-only quick login. Never enable outside local work.
NEXT_PUBLIC_DEV_QUICK_LOGIN="false"
NEXT_PUBLIC_DEV_PASSWORD=""
