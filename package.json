{
    "name": "keyhold-frontend",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@10.17.0",
    "engines": {
        "node": "22.x"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "format": "prettier --write .",
        "type-check": "npx tsc --noEmit",
        "prepare": "git config --unset-all core.hooksPath || exit 0",
        "enums:check": "node --experimental-strip-types --no-warnings=ExperimentalWarning tools/run-enum-parity.mts",
        "test": "vitest run",
        "test:watch": "vitest",
        "codemod:extract-hooks": "jiti tools/codemods/run-extract-transport-to-hook.ts",
        "contract": "jiti tools/contract/run-generate-contract.ts",
        "contract:check": "jiti tools/contract/run-generate-contract.ts --check"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,css}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@base-ui/react": "^1.8.0",
        "@sentry/nextjs": "^10.73.0",
        "@stripe/react-stripe-js": "^6.8.2",
        "@stripe/stripe-js": "^9.14.0",
        "@tanstack/react-query": "^5.96.2",
        "@tanstack/react-query-devtools": "^5.96.2",
        "axios": "^1.14.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.5.0",
        "jose": "^6.2.10",
        "lucide-react": "^0.552.0",
        "maplibre-gl": "^6.8.0",
        "motion": "^12.38.0",
        "nanoid": "^6.0.0",
        "next": "16.0.10",
        "react": "19.2.1",
        "react-dom": "19.2.1",
        "recharts": "^3.9.2",
        "tailwind-merge": "^3.6.0",
        "zod": "^4.4.3",
        "zustand": "^5.0.12"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/postcss": "^4.1.18",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.6",
        "@types/node": "^20.19.27",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/rule-tester": "^8.70.1",
        "@typescript-eslint/utils": "^8.70.1",
        "@vitejs/plugin-react": "^6.1.0",
        "baseline-browser-mapping": "^2.10.21",
        "eslint": "^10.1.0",
        "eslint-config-next": "16.2.10",
        "eslint-plugin-unused-imports": "^4.4.1",
        "fast-check": "^4.10.2",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "jsdom": "^30.0.1",
        "lint-staged": "^17.0.8",
        "prettier": "^3.7.4",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "tailwindcss": "^4.1.18",
        "ts-morph": "^28.0.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.57.1",
        "vitest": "^4.1.11",
        "vitest-axe": "^0.1.0"
    }
}
